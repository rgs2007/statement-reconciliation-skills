# Run output — regenerated, never committed.
# These patterns are anchored so they cannot swallow the golden baseline in
# tests/fixtures/*/expected/, which IS committed and is the whole point.
/runs/
/run/
/report.md
/reports/
/metrics.json
/breaks.csv
/residual.csv

# A live reconciliation working folder — may contain client data.
/reconciliation/
/cache/
*.db
/decisions.jsonl

# Client data must never be committed: git history is permanent, and a
# private repo can be shared later.
*_raw.csv
/data/
/client/
/sources/

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
.idea/
.vscode/

# Public test data fetched on demand by tests/public/fetch_public.py, never
# committed: the large ReconRiver packs (size) and the cuadrador set (its
# source states no license, so it is not redistributed from this repository).
/tests/public/reconriver/inputs/month-end-close/
/tests/public/reconriver/inputs/failure-recovery/
/tests/public/reconriver/expected/month-end-close/
/tests/public/reconriver/expected/failure-recovery/
/tests/public/cuadrador/inputs/
/tests/public/cuadrador/expected/sample_data/
